# Copy to .env before `docker compose up`. Every MAILDEV_* variable of the
# backend can be set here; these are the ones a first install needs.

# Required: base64 of 32 random bytes (openssl rand -base64 32). Encrypts the
# stored project credentials and relay secrets. Losing it makes them unreadable.
MAILDEV_MASTER_KEY=change-me-run-openssl-rand-base64-32

# dev   = any username, shared password below, MAILDEV_ADMIN_USERS are admins (local trials)
# local = password accounts only, first admin created by MAILDEV_ADMIN_USERS? no: create via UI after `local` bootstrap (see README)
# ldap  = Active Directory over LDAPS (set the MAILDEV_LDAP_* variables)
MAILDEV_AUTH_MODE=dev
MAILDEV_DEV_PASSWORD=dev
MAILDEV_ADMIN_USERS=admin

# Names shown to users (web URL and the SMTP/IMAP/POP3 host)
MAILDEV_HOSTNAME=localhost
MAILDEV_PUBLIC_URL=http://localhost:3000
MAILDEV_MAIL_HOST=localhost

# Host ports (container ports are fixed: 1025/1587/1465/1143/1993/1110/1995/8080/3000)
WEB_PORT=3000
API_PORT=8080
SMTP_PORT=1025
SUBMISSION_PORT=1587
SMTPS_PORT=1465
IMAP_PORT=1143
IMAPS_PORT=1993
POP3_PORT=1110
POP3S_PORT=1995

# Active Directory / LDAP (MAILDEV_AUTH_MODE=ldap)
# MAILDEV_LDAP_URL=ldaps://dc01.example.com:636
# MAILDEV_LDAP_BASE_DN=ou=users,dc=example,dc=com
# MAILDEV_LDAP_UPN_SUFFIX=example.com
# MAILDEV_LDAP_CA_FILE=/certs/ldap-ca.crt
# MAILDEV_LDAP_BIND_DN=            # optional service account, enables username lookup
# MAILDEV_LDAP_BIND_PASSWORD=
# MAILDEV_DIRECTORY_URL=           # optional JSON list of company users for the member picker

# Optional at-rest encryption with OpenBao/Vault Transit (AppRole or token)
# MAILDEV_OPENBAO_ADDR=http://openbao:8200
# MAILDEV_OPENBAO_ROLE_ID=
# MAILDEV_OPENBAO_SECRET_ID=
# MAILDEV_OPENBAO_TRANSIT_MOUNT=transit

# S/MIME signature trust: CA chain URLs (PKI secrets engine ca_chain endpoints) and/or a PEM file
# MAILDEV_SMIME_CA_URLS=
# MAILDEV_SMIME_CA_FILE=/certs/smime-ca.pem
MAILDEV_SMIME_SYSTEM_ROOTS=true

# Limits
MAILDEV_MAX_MESSAGE_BYTES=26214400
MAILDEV_SESSION_TTL=12h
MAILDEV_COOKIE_SECURE=false      # true behind HTTPS
