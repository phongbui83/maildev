# Copy to .env. Every variable of the full edition is accepted; these are the
# ones that matter for a lite site.

# Hostname the users connect to (web UI, SMTP, IMAP, POP3). Must match the certificate.
MAILDEV_HOSTNAME=maildev.customer.local
MAILDEV_PUBLIC_URL=https://maildev.customer.local

# First admin account, created only when no admin exists (password change forced at first login).
MAILDEV_LITE_ADMIN_USER=admin
MAILDEV_LITE_ADMIN_PASSWORD=admin
MAILDEV_LITE_PROJECT_NAME=Default

# Message size limit (bytes) and session lifetime.
MAILDEV_MAX_MESSAGE_BYTES=26214400
MAILDEV_SESSION_TTL=12h

# Plain HTTP on 8080 is also served (for a reverse proxy). Set to "" to disable.
# MAILDEV_HTTP_ADDR=:8080
# Behind a plain-HTTP reverse proxy the session cookie needs this:
# MAILDEV_COOKIE_SECURE=false

# Optional: a fixed master key (base64 of 32 bytes). Otherwise one is generated
# into /data/master.key on first start. Back it up together with the database.
# MAILDEV_MASTER_KEY=
