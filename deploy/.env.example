# Backend configuration (every option is an environment variable).
MAILDEV_HTTP_ADDR=:8080
MAILDEV_SMTP_ADDRS=:1025,:587        # plaintext + STARTTLS
MAILDEV_SMTPS_ADDRS=:465             # implicit TLS
MAILDEV_IMAP_ADDRS=:1143
MAILDEV_IMAPS_ADDRS=:993
MAILDEV_POP3_ADDRS=:1110
MAILDEV_POP3S_ADDRS=:995
MAILDEV_PUBLIC_SMTP_PORTS=          # ports shown in setup guides when a LB maps them (e.g. 25,587)
MAILDEV_PUBLIC_SMTPS_PORTS=
MAILDEV_PUBLIC_IMAP_PORTS=
MAILDEV_PUBLIC_IMAPS_PORTS=
MAILDEV_HOSTNAME=maildev.local       # SMTP/IMAP greeting + self-signed cert name
MAILDEV_PUBLIC_URL=http://localhost:3000
MAILDEV_MAIL_HOST=localhost          # host shown to users in setup guides
MAILDEV_TLS_CERT=                    # optional PEM; self-signed is generated when empty
MAILDEV_TLS_KEY=

MAILDEV_DATABASE_URL=postgres://maildev:maildev@localhost:5432/maildev?sslmode=disable
MAILDEV_MASTER_KEY=                  # REQUIRED: openssl rand -base64 32 (encrypts stored credentials)

MAILDEV_AUTH_MODE=ldap               # ldap | dev (dev: any user, password "dev")
MAILDEV_LDAP_URL=ldaps://dc01.example.com:636
MAILDEV_LDAP_BASE_DN=ou=members,dc=example,dc=com
MAILDEV_LDAP_UPN_SUFFIX=example.com   # users bind as <username>@<suffix>
MAILDEV_LDAP_BIND_DN=                # optional service account; enables username lookup when adding members
MAILDEV_LDAP_BIND_PASSWORD=
MAILDEV_LDAP_CA_FILE=                # PEM of the AD CA (or the pinned server cert)
MAILDEV_LDAP_INSECURE_SKIP_VERIFY=false
MAILDEV_ADMIN_USERS=buithephong      # comma separated; granted admin role at login

MAILDEV_SESSION_TTL=12h
MAILDEV_COOKIE_SECURE=true
MAILDEV_MAX_MESSAGE_BYTES=26214400
MAILDEV_DEMO_PROJECT=true            # create the auto-join "demo" project
MAILDEV_LOG_MAIL_EVENTS=true

MAILDEV_SMIME_CA_URLS=               # PEM chain URLs for S/MIME signature verification (e.g. https://vault.example.com/v1/pki-int/ca_chain)
MAILDEV_SMIME_CA_FILE=               # or a PEM bundle on disk
MAILDEV_SMIME_SYSTEM_ROOTS=true      # also trust the OS root store

MAILDEV_OPENBAO_ADDR=                # enables at-rest encryption via OpenBao Transit (e.g. http://openbao-active.openbao.svc:8200)
MAILDEV_OPENBAO_ROLE_ID=             # AppRole from deploy/openbao/setup.sh (or MAILDEV_OPENBAO_TOKEN)
MAILDEV_OPENBAO_SECRET_ID=
MAILDEV_OPENBAO_TRANSIT_MOUNT=transit
MAILDEV_ENCRYPT_BACKLOG=true         # encrypt messages stored before encryption was enabled

MAILDEV_DIRECTORY_URL=               # JSON list of company users for the member picker (e.g. https://directory.example.com/users/)
MAILDEV_DIRECTORY_DISABLE_MISSING=false  # disable AD accounts that disappear from the directory list (batch, every refresh)
